# ─────────────────────────────────────────────────────────────
# ATLAS STUDY — variabili d'ambiente (solo lato server)
# Copia questo file in .env.local e inserisci le tue chiavi.
# Nessuna chiave viene mai inviata al browser.
# ─────────────────────────────────────────────────────────────

# AI Professor, generazione flashcard/quiz, analisi Feynman,
# ricerca web accademica (tool web_search di Claude).
ANTHROPIC_API_KEY=

# Modello Claude (opzionale). Default: claude-opus-5-5
ATLAS_AI_MODEL=

# YouTube Data API v3 — ricerca reale di videolezioni.
# https://developers.google.com/youtube/v3/getting-started
YOUTUBE_API_KEY=

# Supabase (predisposto, vedi supabase/schema.sql e README)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
